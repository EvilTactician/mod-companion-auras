[worldserver]

########################################
# mod-companion-auras
########################################
#
#    CompanionAuras.Enable
#        Description: Give real players their companion's aura while a companion (vanity pet) is out.
#                     Companion names (.petname) and CompanionAuras.Resummon work either way.
#        Default:     1 - Enabled
#                     0 - Disabled
#

CompanionAuras.Enable = 1

#
#    CompanionAuras.DisableInBattlegrounds
#        Description: No companion auras inside battlegrounds and arenas. They come back
#                     when you leave, if your companion is still out.
#        Default:     1 - No companion auras in battlegrounds and arenas
#                     0 - Companion auras everywhere
#

CompanionAuras.DisableInBattlegrounds = 1

#
#    CompanionAuras.Resummon
#        Description: In 3.3.5 a companion goes away on every loading screen. With this on, the
#                     companion you had out comes back after a teleport, hearthstone, flight,
#                     death or logging in. If you dismissed it yourself, it stays away.
#                     It waits until it is safe: out of combat, not stealthed or invisible, landed,
#                     off boats and vehicles, not casting or on a flight, and gives up after 3 tries.
#        Default:     1 - Bring companions back
#                     0 - Leave them away, like the stock game
#

CompanionAuras.Resummon = 1

#
#    CompanionAuras.WorldDrop.Chance
#        Description: Companions nothing else on the realm gives can drop from any creature
#                     with a loot table, as a very rare extra roll: 1 in this many kills.
#                     Existing loot tables are not changed. Only kills by real players (or a
#                     group with a real player in it) roll.
#        Default:     20000 - 1 in 20,000 kills
#                     0     - No world drops
#

CompanionAuras.WorldDrop.Chance = 20000
